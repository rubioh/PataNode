                                },
                                "persistence": {
                                    "type": null,
                                    "param_name": "persistence"
                                },
                                "noise_threshold": {
                                    "type": null,
                                    "param_name": "noise_threshold"
                                },
                                "flow_valid": {
                                    "type": null,
                                    "param_name": "flow_valid"
                                },
                                "drift": {
                                    "type": null,
                                    "param_name": "drift"
                                }
