                    {
                        "id": 2334377212240,
                        "title": "Motion Flow",
                        "pos_x": -614.2812499999999,
                        "pos_y": -82.51171875000009,
                        "inputs": [
                            {
                                "id": 2334377082320,
                                "index": 0,
                                "multi_edges": false,
                                "position": 2,
                                "socket_type": 1
                            }
                        ],
                        "outputs": [
                            {
                                "id": 2334377140944,
                                "index": 0,
                                "multi_edges": true,
                                "position": 5,
                                "socket_type": 3
                            }
                        ],
                        "content": {},
                        "op_code": 1102,
                        "cpu_adaptable_parameters": {
                            "prefilter_program": {},
                            "flow_program": {},
                            "smooth_program": {},
                            "accum_program": {},
                            "program": {}
                        },
                        "gpu_adaptable_parameters": {
                            "prefilter_program": {
                                "iChannel0": {
                                    "eval_function": {
                                        "name": "eval_function",
                                        "type": "f4",
                                        "value": "x",
                                        "widget": "TextEdit",
                                        "protected": true
                                    }
                                }
                            },
                            "flow_program": {
                                "CurrLuma": {
                                    "eval_function": {
                                        "name": "eval_function",
                                        "type": "f4",
                                        "value": "x",
                                        "widget": "TextEdit",
                                        "protected": true
                                    }
                                },
                                "PrevLuma": {
                                    "eval_function": {
                                        "name": "eval_function",
                                        "type": "f4",
                                        "value": "x",
                                        "widget": "TextEdit",
                                        "protected": true
                                    }
                                },
                                "lambda_reg": {
                                    "eval_function": {
                                        "name": "eval_function",
                                        "type": "f4",
                                        "value": "1",
                                        "widget": "TextEdit",
                                        "protected": false,
                                        "doc": {
                                            "description": "Steadiness of the estimate, as a fraction of how much detail the image has locally. Higher is calmer and copes better with noisy or flat footage, at the cost of understating how fast things really move. Lower is more responsive and more jittery.",
                                            "default": 0.05,
                                            "minimum": 0.001,
                                            "maximum": 1.0
                                        }
                                    }
                                }
                            },
                            "smooth_program": {
                                "FlowTex": {
                                    "eval_function": {
                                        "name": "eval_function",
                                        "type": "f4",
                                        "value": "x",
                                        "widget": "TextEdit",
                                        "protected": true
                                    }
                                }
                            },
                            "accum_program": {
                                "FlowTex": {
                                    "eval_function": {
                                        "name": "eval_function",
                                        "type": "f4",
                                        "value": "x",
                                        "widget": "TextEdit",
                                        "protected": true
                                    }
                                },
                                "AccumTex": {
                                    "eval_function": {
                                        "name": "eval_function",
                                        "type": "f4",
                                        "value": "x",
                                        "widget": "TextEdit",
                                        "protected": true
                                    }
                                },
                                "flow_gain": {
                                    "eval_function": {
                                        "name": "eval_function",
                                        "type": "f4",
                                        "value": "70",
                                        "widget": "TextEdit",
                                        "protected": false,
                                        "doc": {
                                            "description": "How strongly movement registers. Multiplies the length of every motion vector, so it scales how hard this node pushes whatever it drives. At 0 the field is always empty and nothing downstream moves.",
                                            "default": 1.0,
                                            "minimum": 0.0,
                                            "maximum": 8.0
                                        }
                                    }
                                },
                                "persistence": {
                                    "eval_function": {
                                        "name": "eval_function",
                                        "type": "f4",
                                        "value": ".99",
                                        "widget": "TextEdit",
                                        "protected": false,
                                        "doc": {
                                            "description": "How long movement lingers once it stops. At 0 the field dies the instant something stops moving, which is sharp but flickery. Near 1 a single gesture leaves a trail that keeps driving effects for seconds afterwards. This is the main feel control.",
                                            "default": 0.85,
                                            "minimum": 0.0,
                                            "maximum": 0.98
                                        }
                                    }
                                },
                                "noise_threshold": {
                                    "eval_function": {
                                        "name": "eval_function",
                                        "type": "f4",
                                        "value": "0.15",
                                        "widget": "TextEdit",
                                        "protected": false,
                                        "doc": {
                                            "description": "Movement fainter than this is thrown away. Raise it when a grainy or low-light camera makes the whole frame shimmer with motion that is not there. Too high and genuine slow movement disappears along with the noise.",
                                            "default": 0.002,
                                            "minimum": 0.0,
                                            "maximum": 0.02
                                        }
                                    }
                                },
                                "flow_valid": {
                                    "eval_function": {
                                        "name": "eval_function",
                                        "type": "f4",
                                        "value": "x",
                                        "widget": "TextEdit",
                                        "protected": true
                                    }
                                },
                                "drift": {
                                    "eval_function": {
                                        "name": "eval_function",
                                        "type": "f4",
                                        "value": ".01",
                                        "widget": "TextEdit",
                                        "protected": false,
                                        "doc": {
                                            "description": "Whether trails travel or fade where they were made. At 0 a trail sits still and dims in place. At 1 it keeps sliding in the direction the movement was going after that movement has stopped, stretching and curling as it goes, like smoke coming off a gesture. Above 1 it races away faster than the motion that made it. Turn persistence up alongside this, or the trail fades before it has gone anywhere.",
                                            "default": 1.0,
                                            "minimum": 0.0,
                                            "maximum": 8.0
                                        }
                                    }
                                }
                            },
                            "program": {
                                "AccumTex": {
                                    "eval_function": {
                                        "name": "eval_function",
                                        "type": "f4",
                                        "value": "x",
                                        "widget": "TextEdit",
                                        "protected": true
                                    }
                                },
                                "magnitude_scale": {
                                    "eval_function": {
                                        "name": "eval_function",
                                        "type": "f4",
                                        "value": "0.001",
                                        "widget": "TextEdit",
                                        "protected": false,
                                        "doc": {
                                            "description": "Affects the blue channel only, where this node reports movement as a 0-1 mask. Sets how much movement counts as fully lit. Raise it if the mask stays dim, lower it if the slightest twitch blows it out to solid white. The flow vectors themselves are untouched.",
                                            "default": 8.0,
                                            "minimum": 1.0,
                                            "maximum": 50.0
                                        }
                                    }
                                }
                            }
                        },
                        "uniforms_binding": {
                            "prefilter_": {
                                "iResolution": {
                                    "type": null,
                                    "param_name": "compute_size"
                                },
                                "iChannel0": {
